# ── Zerodha Kite Connect API Credentials ──
# Get your API key and secret from: https://developers.kite.trade/
# 1. Create a Zerodha developer account
# 2. Create a new app
# 3. Set redirect URL to: http://127.0.0.1:8182/api/kite/callback
# 4. Copy your API Key and API Secret below

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_REDIRECT_URL=http://127.0.0.1:8182/api/kite/callback
